includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - routes
        - tests
    ignoreErrors:
        # Larastan only treats the application's config directory as config;
        # the package's own config file and the test bootstrapping read env.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - config/*
                - tests/*
        # The queue key method exists from Laravel 13.5 only, so the check for
        # it is always true when analysing against a newer version.
        -
            identifier: function.alreadyNarrowedType
            path: src/QueueKeys.php
            reportUnmatched: false
